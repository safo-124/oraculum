# Copy this file to .env and replace the placeholder values with your own.
# Never commit the real .env file. No AI API keys are needed: every model is
# open-weight and runs locally.

DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_assistant

# Model server: llama.cpp `llama-server` with Qwen2.5-Instruct (GGUF).
LLM_BASE_URL=http://127.0.0.1:8081
CHAT_MODEL=qwen2.5-1.5b-instruct
CHAT_MAX_TOKENS=400
CHAT_TEMPERATURE=0.0

# Local PyTorch encoders (downloaded from Hugging Face on first use).
MODEL_DEVICE=cpu
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VERIFIER_MODEL=cross-encoder/nli-deberta-v3-xsmall

# Calibrated abstention: answers are gated once this file exists
# (written by `uv run python -m research study`).
CONFIDENCE_CALIBRATOR_PATH=models/calibrator.json

# Ingestion (chunk sizes are in embedding-model tokens; bge reads <= 512)
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
MAX_FILE_SIZE_BYTES=10485760
UPLOADS_DIR=data/uploads
CHROMA_DIR=data/chroma

# Retrieval: BM25 + vectors fused with RRF, then cross-encoder reranking.
RETRIEVAL_TOP_K=5
RETRIEVAL_HYBRID=true
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK=true
RERANK_CANDIDATES=20
BM25_DB_PATH=data/bm25.db

# Public demo (guest chat on the shared corpus); off for local development.
GUEST_MODE_ENABLED=false

# Reliability and security
RATE_LIMIT_PER_MINUTE=10
# API_KEY=change_me_to_a_long_random_string

# Logging: rotating file, 5 MB x 4. Set empty to disable.
LOG_FILE=data/logs/oraculum.log
