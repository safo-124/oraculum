# /etc/oraculum/oraculum.env  (owner root:oraculum, mode 640)
DATABASE_URL=postgresql://oraculum:CHANGE_ME@127.0.0.1:5432/oraculum

# Public demo: guests chat about the shared corpus without an account;
# visitors may also sign up to upload their own (private) documents, within
# limits sized for a small server: worst case 100 x 10 MB = 1 GB of uploads.
GUEST_MODE_ENABLED=true
AUTH_ALLOW_ANONYMOUS=false
AUTH_ALLOW_REGISTRATION=true
AUTH_REGISTER_RATE_LIMIT_PER_MINUTE=3
AUTH_MAX_USERS=100
UPLOAD_MAX_DOCUMENTS_PER_USER=5
UPLOAD_MAX_BYTES_PER_USER=10485760
AUTH_COOKIE_SECURE=true
GUEST_RATE_LIMIT_PER_MINUTE=4
GUEST_GLOBAL_RATE_LIMIT_PER_MINUTE=20

# Open models
LLM_BASE_URL=http://127.0.0.1:8081
CHAT_MODEL=qwen2.5-0.5b-instruct
# 4 passages keep prompts short for 2 vCPUs (answers in ~10-20 s).
RETRIEVAL_TOP_K=4
MODEL_DEVICE=cpu
HF_HOME=/srv/oraculum/.cache/huggingface
OMP_NUM_THREADS=2
# The usage ledger and logs stay small; models load once at startup.
TOKENIZERS_PARALLELISM=false

# Usage ledger stays on (latency + tokens); local models have no price.
USAGE_LEDGER_ENABLED=true
